<span class="material-symbols-outlined text-architectural-blue">mop</span>
<span class="font-body-md">Deep Cleaning</span>
</button>
<button class="w-full text-left p-4 rounded-lg flex items-center gap-3 group transition-all hover:bg-surface-container" id="btn-stain" onclick="scrollToSection('stain-removal')">
