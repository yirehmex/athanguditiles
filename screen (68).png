<span class="material-symbols-outlined text-[18px]">share</span> EXPORT SPECS
                    </span>
<span class="inline-flex items-center gap-2 px-4 py-2 bg-heritage-crimson text-white rounded-full text-label-sm font-semibold">
<span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">calendar_today</span> SCHEDULE SITE VISIT
                    </span>
</div>
</div>
</header>
<!-- Main Dashboard Grid -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter">
<!-- LEFT COLUMN: Status & Timeline (8 Columns) -->
