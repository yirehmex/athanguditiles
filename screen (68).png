<main class="pt-32 pb-24 px-margin-mobile md:px-margin-desktop max-w-max-width mx-auto">
<!-- Header Section -->
<header class="mb-16">
<div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
<div>
<p class="font-label-sm text-label-sm text-heritage-crimson uppercase tracking-[0.2em] mb-2">Project ID: YM-2024-8842</p>
<h1 class="font-display-lg text-display-lg text-architectural-blue">The Azure Coastal Villa</h1>
</div>
<div class="flex gap-3">
