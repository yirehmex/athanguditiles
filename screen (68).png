<div class="h-full bg-heritage-crimson rounded-full" style="width: 25%;"></div>
</div>
<div class="grid grid-cols-2 md:grid-cols-6 gap-6">
    <div class="opacity-100">
        <span class="material-symbols-outlined text-heritage-crimson mb-2" style="font-variation-settings: 'FILL' 1;">check_circle</span>
        <p class="font-label-sm text-label-sm font-bold text-on-surface mb-1">DESIGN FINALIZED</p>
        <p class="text-[10px] text-on-surface-variant uppercase">Completed</p>
    </div>
