<!-- Project Timeline Sidebar -->
<div class="bg-surface-container-high/50 p-8 rounded-xl border border-outline-variant/20">
<h3 class="font-label-sm text-label-sm font-bold text-on-surface mb-8 uppercase tracking-widest">Activity Timeline</h3>
<div class="space-y-8 relative">
<!-- Timeline line -->
<div class="absolute left-[15px] top-2 bottom-2 w-[1px] bg-outline-variant/40"></div>
<div class="relative pl-10">
<div class="absolute left-0 top-1 w-8 h-8 flex items-center justify-center bg-heritage-crimson text-white rounded-full scale-50 -translate-x-[20%]"></div>
<p class="text-[12px] text-on-surface-variant mb-1">TODAY, 10:24 AM</p>
<p class="text-body-md text-[14px] font-semibold">Samples dispatched from Karaikudi unit</p>
<p class="text-body-md text-[12px] text-on-surface-variant">Tracking: YX-44281903</p>
</div>
<div class="relative pl-10">
<div class="absolute left-0 top-1 w-8 h-8 flex items-center justify-center bg-outline-variant text-white rounded-full scale-50 -translate-x-[20%]"></div>
<p class="text-[12px] text-on-surface-variant mb-1">MAR 28, 2:15 PM</p>
<p class="text-body-md text-[14px] font-semibold">Custom pigment mix approved</p>
<p class="text-body-md text-[12px] text-on-surface-variant">Color: Azure Sea Ref #442</p>
</div>
