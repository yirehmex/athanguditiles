<style>
        .custom-scrollbar::-webkit-scrollbar { width: 4px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #e2beba; border-radius: 10px; }
        .glass-panel { backdrop-filter: blur(20px); background: rgba(255, 248, 247, 0.8); }
        .masonry-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); grid-auto-rows: 10px; }
        .active-dot { position: relative; }
        .active-dot::after { content: ''; position: absolute; top: -2px; right: -2px; width: 8px; height: 8px; background: #B22222; border-radius: 50%; border: 2px solid white; }
    </style>
