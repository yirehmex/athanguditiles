    </div>
    <div class="opacity-50">
        <span class="material-symbols-outlined text-outline mb-2">pan_tool</span>
        <p class="font-label-sm text-label-sm font-bold text-on-surface mb-1">HAND-PRESSING</p>
        <p class="text-[10px] text-on-surface-variant uppercase">Scheduled</p>
    </div>
    <div class="opacity-50">
        <span class="material-symbols-outlined text-outline mb-2">wb_sunny</span>
        <p class="font-label-sm text-label-sm font-bold text-on-surface mb-1">CURING &amp; POLISH</p>
        <p class="text-[10px] text-on-surface-variant uppercase">Scheduled</p>
    </div>
    <div class="opacity-50">
        <span class="material-symbols-outlined text-outline mb-2">verified</span>
        <p class="font-label-sm text-label-sm font-bold text-on-surface mb-1">QUALITY ASSURE</p>
