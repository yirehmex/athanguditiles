<div class="bg-surface-container p-6 rounded-xl border border-outline-variant/20" style="opacity: 1; transform: translateY(0px); transition: 0.6s cubic-bezier(0.23, 1, 0.32, 1) 0.9s;">
<h3 class="font-label-sm text-label-sm font-bold text-on-surface mb-4 uppercase tracking-widest">Technical Documents</h3>
