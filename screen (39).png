</div>
<script>
        function toggleSheet() {
            const sheet = document.getElementById('bottomSheet');
            sheet.classList.toggle('open');
        }

        // Lightweight micro-interaction for tile selection
        document.querySelectorAll('.grid > div').forEach(item => {
            item.addEventListener('click', function() {
                // In a real app, this would update the main visualizer grid
                console.log('Tile Selected');
                // Pulse animation
                this.classList.add('scale-95');
                setTimeout(() => this.classList.remove('scale-95'), 100);
            });
        });

        // Simple touch/drag handling for mobile
        let startY;
        const sheet = document.getElementById('bottomSheet');
        
        sheet.addEventListener('touchstart', e => {
            startY = e.touches[0].clientY;
        });

        sheet.addEventListener('touchmove', e => {
            const moveY = e.touches[0].clientY;
            const diff = startY - moveY;
            if (diff > 50 && !sheet.classList.contains('open')) {
                sheet.classList.add('open');
            } else if (diff < -50 && sheet.classList.contains('open')) {
                sheet.classList.remove('open');
            }
        });
    </script>
</body></html>