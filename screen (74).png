<script>
        // Simple micro-interaction for file upload visualization
        const fileUpload = document.getElementById('file-upload');
        const fileList = document.getElementById('file-list');
        const dropZone = document.getElementById('drop-zone');

        fileUpload.addEventListener('change', (e) => {
            handleFiles(e.target.files);
        });

        dropZone.addEventListener('dragover', (e) => {
            e.preventDefault();
            dropZone.classList.add('border-heritage-crimson');
        });

        dropZone.addEventListener('dragleave', () => {
            dropZone.classList.remove('border-heritage-crimson');
        });

        dropZone.addEventListener('drop', (e) => {
            e.preventDefault();
            dropZone.classList.remove('border-heritage-crimson');
            handleFiles(e.dataTransfer.files);
        });

        function handleFiles(files) {
            fileList.innerHTML = '';
            Array.from(files).forEach(file => {
                const chip = document.createElement('div');
                chip.className = 'flex items-center gap-2 bg-surface-container text-on-surface px-3 py-1 rounded-full font-label-sm text-label-sm border border-outline-variant';
                chip.innerHTML = `
                    <span class="material-symbols-outlined text-[16px]">attachment</span>
                    ${file.name.substring(0, 20)}${file.name.length > 20 ? '...' : ''}
                    <span class="material-symbols-outlined text-[16px] cursor-pointer hover:text-error" onclick="this.parentElement.remove()">close</span>
                `;
                fileList.appendChild(chip);
            });
        }

        // Smooth scroll for nav links (standard UX)
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if(target) {
                    window.scrollTo({
                        top: target.offsetTop - 80,
                        behavior: 'smooth'
                    });
                }
            });
        });
    </script>
</body></html>