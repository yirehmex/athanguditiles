</section>
</main>
<!-- Floating Filter Button (Mobile Only) -->
<button class="md:hidden fixed bottom-6 right-6 z-40 bg-heritage-crimson text-white w-14 h-14 rounded-full flex items-center justify-center shadow-2xl active:scale-90 transition-transform" onclick="toggleFilter()">
<span class="material-symbols-outlined">filter_alt</span>
</button>
<!-- Full Screen Filter Overlay -->
<div class="fixed inset-0 z-[60] glass-overlay translate-y-full transition-transform duration-500 flex flex-col" id="filterOverlay">
