<button class="mt-6 font-label-sm text-label-sm text-heritage-crimson border border-heritage-crimson px-6 py-2 rounded-lg hover:bg-heritage-crimson hover:text-white transition-all" onclick="document.getElementById('file-upload').click()" type="button">Select Files</button>
