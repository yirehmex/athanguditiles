<div class="flex gap-6">
<a class="text-surface-variant/80 hover:text-surface-bright transition-colors" href="#"><span class="material-symbols-outlined">public</span></a>
<a class="text-surface-variant/80 hover:text-surface-bright transition-colors" href="#"><span class="material-symbols-outlined">alternate_email</span></a>
